# n8n webhook that receives job applications from /hiring/ and creates a page in
# the Notion Applications DB. This is the only secret the site build needs.
#
# Vacancy CONTENT is not fetched at build time — an n8n sync writes it into
# src/content/vacancies/ as Markdown, so the build never talks to the Notion API.
PUBLIC_N8N_WEBHOOK=https://nnnnnnnn.calma.ad/webhook/calma-hiring-apply
