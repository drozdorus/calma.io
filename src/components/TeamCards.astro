---
// The team roster as avatar cards — the homepage team section and /hiring/
// render the same people the same way. Wrap in a .team-scroller > .team-track
// of your own; card accents come from accentFor (mint → amber across the row).
import { team, accentFor } from '../data/team';
---

{team.map((m, i) => (
  <div class="team-card" style={`--card-accent: ${accentFor(i, team.length)}`}>
    <div class="team-avatar-wrap">
      <div class="team-avatar">
        <img src={`/img/team/${m.img}`} alt={m.alt} />
      </div>
      {(m.website || m.linkedin) && (
        <div class="team-links">
          {m.website && (
            <a href={m.website} class="team-link" target="_blank" rel="noopener" aria-label="Website">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="2" y1="12" x2="22" y2="12" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            </a>
          )}
          {m.linkedin && (
            <a href={m.linkedin} class="team-link" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            </a>
          )}
        </div>
      )}
    </div>
    <div class="team-info">
      <div class="team-name">{m.name}</div>
      <div class="team-role">{m.role}</div>
    </div>
  </div>
))}
