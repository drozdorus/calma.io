---
// "By the Numbers" — a sibling of Our Methodology inside About: same h3,
// same glass cards, so it reads as part of the section, not a bolt-on.
import { stats } from '../data/stats';
---

<div class="methodology stats">
  <h3 class="methodology-title">By the Numbers</h3>
  <dl class="methodology-grid stats-grid">
    {stats.map((s) => (
      <div class="methodology-item stat">
        <dt class="methodology-desc">{s.label}</dt>
        <dd class="stat-value">{s.value}</dd>
      </div>
    ))}
  </dl>
</div>
