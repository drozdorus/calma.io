---
// "By the Numbers" — the strongest proof on the page, so it's the visual
// peak: giant fluid-size figures, full container width, hairline dividers
// instead of boxed cards. The count-up (script.js) is a progressive
// enhancement — the final value below is what renders without JS and what
// crawlers see; IntersectionObserver swaps it for a 0→target animation
// once the block scrolls into view, then restores the exact source string.
import { stats } from '../data/stats';
---

<div class="stats-strip" aria-label="By the numbers">
  <p class="stats-strip-eyebrow">By the Numbers</p>
  <dl class="stats-row">
    {stats.map((s) => (
      <div class="stat-giant">
        <dt class="stat-giant-label">{s.label}</dt>
        <dd
          class="stat-giant-value"
          data-count-to={s.countTo}
          data-count-suffix={s.countSuffix}
          data-final={s.value}
        >{s.value}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .stats-strip {
    margin: 0 auto var(--space-2xl);
    /* Full container width — no inner max-width clamp like the other
       About sub-blocks. */
  }

  .stats-strip-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  /* The row is a size container: the figures are sized from its width so
     the widest value ("No cap", ~3.3em) always fits its cell on one line.
     Every value shares one size and one line, so the four cells read as a
     single even row at any desktop width (no wrapped "3 / days"). */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    container-type: inline-size;
  }

  .stat-giant {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
    padding: var(--space-lg) var(--space-sm);
    border-left: 1px solid var(--border-default);
  }

  .stat-giant:first-child {
    border-left: none;
  }

  .stat-giant-value {
    font-family: var(--font-heading);
    /* (cell width - its 24px + 8px side padding) / widest value in em */
    font-size: clamp(2.75rem, calc((25cqi - 32px) / 3.35), 7.5rem);
    white-space: nowrap;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    /* Restrained gradient accent — same brand signature as the hero title,
       used sparingly here (one block on the page). */
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    /* background-clip: text paints only inside the box, and line-height: 1
       ends the box above the descenders ("y", "p"), so they rendered cut.
       Grow the paint area down (and a hair right for the overshoot of the
       last glyph under negative tracking) and take it back with negative
       margins, so the layout doesn't move. */
    padding: 0 0.05em 0.2em 0;
    margin: 0 -0.05em -0.2em 0;
  }

  .stat-giant-label {
    order: 2;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  /* Desktop: left-aligned like the rest of the homepage — the eyebrow on
     the heading line, each figure flush with its hairline. */
  @media (min-width: 901px) {
    .stats-strip-eyebrow {
      text-align: left;
    }
    .stat-giant {
      align-items: flex-start;
      text-align: left;
      /* Left-aligned figures need no air on the right, only before the
         next hairline. */
      padding: var(--space-md) 8px var(--space-md) var(--space-md);
    }
    .stat-giant:first-child {
      padding-left: 0;
    }
  }

  @media (max-width: 900px) {
    .stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat-giant-value {
      font-size: clamp(2.75rem, calc((50cqi - 2 * var(--space-sm)) / 3.35), 5.5rem);
    }
    .stat-giant:nth-child(2) {
      border-left: none;
    }
    .stat-giant:nth-child(3) {
      border-left: none;
      border-top: 1px solid var(--border-default);
    }
    .stat-giant:nth-child(4) {
      border-top: 1px solid var(--border-default);
    }
  }

  @media (max-width: 560px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
    .stat-giant-value {
      font-size: 2.75rem;
    }
    .stat-giant {
      border-left: none !important;
      border-top: 1px solid var(--border-default);
      padding: var(--space-md) var(--space-sm);
    }
    .stat-giant:first-child {
      border-top: none;
    }
  }
</style>
